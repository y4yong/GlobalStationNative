# Copy the required values into api/.env. Never commit real secrets.
# AWS SDK credentials use the normal AWS environment/role chain.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-private-video-bucket
MEDIA_UPLOAD_MAX_BYTES=5000000000

# CloudFront trusted key group. Store the private key with literal \\n escapes
# or multiline contents in api/.env; keep it private and out of source control.
CLOUDFRONT_DOMAIN=media.example.com
CLOUDFRONT_KEY_PAIR_ID=your-cloudfront-public-key-id
CLOUDFRONT_PRIVATE_KEY=replace-with-private-key

# Billplz sandbox. Use the account's sandbox API key, collection ID, and X Signature key.
BILLPLZ_MODE=sandbox
BILLPLZ_API_KEY=replace-with-billplz-sandbox-api-key
BILLPLZ_COLLECTION_ID=replace-with-billplz-collection-id
BILLPLZ_X_SIGNATURE_KEY=replace-with-billplz-x-signature-key
BILLPLZ_MONTHLY_PRICE_SEN=1490
BILLPLZ_YEARLY_PRICE_SEN=11990
PUBLIC_API_URL=https://your-public-api-host
