# Local development template. Replace the placeholders before running.
# In AWS, supply production values from Secrets Manager/Parameter Store.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/globalstation
JWT_SECRET=CHANGE_ME_generate_a_random_secret_at_least_32_characters
CORS_ORIGIN=*
TRUST_PROXY=false

MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=./uploads
MEDIA_UPLOAD_MAX_BYTES=5000000000

# For production S3/CloudFront media, set MEDIA_STORAGE_DRIVER=s3 and provide:
# AWS_REGION=ap-southeast-2
# AWS_S3_BUCKET=your-private-media-bucket
# CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net
# CLOUDFRONT_KEY_PAIR_ID=your-cloudfront-public-key-id
# CLOUDFRONT_PRIVATE_KEY=replace-with-private-key

# Stripe test mode; use real credentials only in the secret store.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
VIP_MONTHLY_PRICE_SEN=1490
VIP_YEARLY_PRICE_SEN=11990

# For hosted Stripe Checkout, set the API origin only; do not append /api/v1.
# PUBLIC_API_URL=https://api.example.com

# For RDS TLS, set this to the downloaded CA bundle path on the EC2 instance.
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/rds-global-bundle.pem
